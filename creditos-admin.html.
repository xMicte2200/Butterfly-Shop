<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Créditos | Butterfly Shop</title>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="supabase-config.js"></script>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      min-height: 100vh;
      background:
        radial-gradient(circle at top left, rgba(220, 190, 255, 0.35), transparent 35%),
        linear-gradient(135deg, #fdf7ff, #f4eaff, #fff8fc);
      color: #4b315d;
      padding: 25px;
    }

    .container {
      max-width: 1150px;
      margin: auto;
    }

    header {
      background: rgba(255, 255, 255, 0.88);
      border: 1px solid #ead7f5;
      border-radius: 22px;
      padding: 22px;
      box-shadow: 0 8px 25px rgba(118, 76, 145, 0.12);
      margin-bottom: 22px;
    }

    .header-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
      flex-wrap: wrap;
    }

    h1 {
      color: #7d45a5;
      font-size: 28px;
    }

    .subtitle {
      margin-top: 7px;
      color: #80698d;
      font-size: 14px;
    }

    .btn {
      border: none;
      border-radius: 12px;
      padding: 11px 17px;
      cursor: pointer;
      font-weight: bold;
      transition: 0.2s;
    }

    .btn:hover {
      transform: translateY(-1px);
    }

    .btn-back {
      background: #eee0f8;
      color: #70428e;
    }

    .btn-refresh {
      background: #9b62c4;
      color: white;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      margin-bottom: 22px;
    }

    .stat {
      background: rgba(255, 255, 255, 0.9);
      border: 1px solid #ead7f5;
      border-radius: 18px;
      padding: 20px;
      box-shadow: 0 6px 18px rgba(118, 76, 145, 0.09);
    }

    .stat-icon {
      font-size: 25px;
      margin-bottom: 8px;
    }

    .stat-title {
      color: #80698d;
      font-size: 13px;
    }

    .stat-value {
      color: #713c91;
      font-size: 25px;
      font-weight: bold;
      margin-top: 5px;
    }

    .panel {
      background: rgba(255, 255, 255, 0.93);
      border: 1px solid #ead7f5;
      border-radius: 22px;
      padding: 22px;
      box-shadow: 0 8px 25px rgba(118, 76, 145, 0.11);
    }

    .panel-title {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      margin-bottom: 18px;
      flex-wrap: wrap;
    }

    .panel-title h2 {
      color: #713c91;
      font-size: 21px;
    }

    .table-wrapper {
      width: 100%;
      overflow-x: auto;
      border-radius: 15px;
      border: 1px solid #eadff0;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 700px;
    }

    th {
      background: #f5eafa;
      color: #71418d;
      font-size: 13px;
      text-align: left;
      padding: 14px;
    }

    td {
      padding: 14px;
      border-top: 1px solid #eee5f2;
      font-size: 14px;
      color: #594565;
    }

    tr:hover td {
      background: #fcf8ff;
    }

    .credits {
      font-weight: bold;
      color: #7c42a3;
    }

    .role {
      display: inline-block;
      padding: 5px 9px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: bold;
    }

    .role-admin {
      background: #ead7fa;
      color: #713c91;
    }

    .role-user {
      background: #f6eaf8;
      color: #815b8e;
    }

    .loading,
    .empty,
    .error {
      text-align: center;
      padding: 35px 15px;
      color: #80698d;
    }

    .error {
      color: #a13f68;
    }

    @media (max-width: 750px) {
      body {
        padding: 14px;
      }

      .stats {
        grid-template-columns: 1fr;
      }

      h1 {
        font-size: 23px;
      }

      .panel,
      header {
        padding: 17px;
      }
    }
  </style>
</head>

<body>

  <div class="container">

    <header>
      <div class="header-top">

        <div>
          <h1>🦋 Administración de Créditos</h1>
          <p class="subtitle">
            Consulta los balances de créditos de los usuarios de Butterfly Shop.
          </p>
        </div>

        <div>
          <button class="btn btn-back" onclick="window.location.href='admin.html'">
            ← Volver
          </button>

          <button class="btn btn-refresh" onclick="cargarCreditos()">
            🔄 Actualizar
          </button>
        </div>

      </div>
    </header>


    <section class="stats">

      <div class="stat">
        <div class="stat-icon">👥</div>
        <div class="stat-title">Usuarios</div>
        <div class="stat-value" id="totalUsuarios">0</div>
      </div>

      <div class="stat">
        <div class="stat-icon">💎</div>
        <div class="stat-title">Créditos totales</div>
        <div class="stat-value" id="totalCreditos">0</div>
      </div>

      <div class="stat">
        <div class="stat-icon">👑</div>
        <div class="stat-title">Administradores</div>
        <div class="stat-value" id="totalAdmins">0</div>
      </div>

    </section>


    <section class="panel">

      <div class="panel-title">
        <h2>💎 Balances de usuarios</h2>
      </div>

      <div id="estado" class="loading">
        Cargando balances... 🦋
      </div>

      <div id="tablaContainer" class="table-wrapper" style="display:none;">

        <table>

          <thead>
            <tr>
              <th>Usuario</th>
              <th>Correo</th>
              <th>Créditos</th>
              <th>Rol</th>
            </tr>
          </thead>

          <tbody id="tablaCreditos"></tbody>

        </table>

      </div>

    </section>

  </div>


  <script>

    let usuarios = [];


    function escaparHTML(texto) {
      if (texto === null || texto === undefined) {
        return "";
      }

      return String(texto)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }


    function formatearCreditos(valor) {
      const numero = Number(valor || 0);

      return numero.toLocaleString("es-MX");
    }


    async function verificarAdmin() {

      const {
        data: {
          user
        },
        error
      } = await supabaseClient.auth.getUser();

      if (error || !user) {
        window.location.href = "index.html";
        return false;
      }


      const {
        data: perfil,
        error: errorPerfil
      } = await supabaseClient
        .from("profiles")
        .select("role")
        .eq("id", user.id)
        .single();


      if (errorPerfil || !perfil || perfil.role !== "admin") {
        alert("No tienes permisos de administrador.");
        window.location.href = "index.html";
        return false;
      }

      return true;
    }


    async function cargarCreditos() {

      const estado = document.getElementById("estado");
      const tablaContainer = document.getElementById("tablaContainer");
      const tabla = document.getElementById("tablaCreditos");

      estado.style.display = "block";
      estado.className = "loading";
      estado.textContent = "Cargando balances... 🦋";

      tablaContainer.style.display = "none";
      tabla.innerHTML = "";


      const {
        data,
        error
      } = await supabaseClient.rpc("get_all_user_credits");


      if (error) {

        console.error("Error al cargar créditos:", error);

        estado.className = "error";
        estado.textContent =
          "❌ No se pudieron cargar los balances: " + error.message;

        return;
      }


      usuarios = data || [];


      document.getElementById("totalUsuarios").textContent =
        usuarios.length.toLocaleString("es-MX");


      const totalCreditos = usuarios.reduce(
        (total, usuario) => total + Number(usuario.credits || 0),
        0
      );


      const totalAdmins = usuarios.filter(
        usuario => usuario.role === "admin"
      ).length;


      document.getElementById("totalCreditos").textContent =
        formatearCreditos(totalCreditos);


      document.getElementById("totalAdmins").textContent =
        totalAdmins.toLocaleString("es-MX");


      if (usuarios.length === 0) {

        estado.className = "empty";
        estado.textContent = "No hay usuarios registrados.";

        return;
      }


      usuarios.forEach(usuario => {

        const fila = document.createElement("tr");

        const username =
          escaparHTML(usuario.username || "Sin username");

        const email =
          escaparHTML(usuario.email || "Sin correo");

        const credits =
          formatearCreditos(usuario.credits);

        const role =
          usuario.role === "admin"
            ? `<span class="role role-admin">👑 Admin</span>`
            : `<span class="role role-user">👤 Usuario</span>`;


        fila.innerHTML = `
          <td>${username}</td>
          <td>${email}</td>
          <td class="credits">💎 ${credits}</td>
          <td>${role}</td>
        `;


        tabla.appendChild(fila);

      });


      estado.style.display = "none";
      tablaContainer.style.display = "block";

    }


    async function iniciar() {

      const esAdmin = await verificarAdmin();

      if (!esAdmin) {
        return;
      }

      await cargarCreditos();

    }


    iniciar();

  </script>

</body>
</html>
